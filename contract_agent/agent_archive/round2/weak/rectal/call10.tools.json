    "arguments": {
      "code": "\nimport re\n\n# Get all TRG data for P81-P128 from supp.pdf page11\ntrg_rows = get_rows(\"supp.pdf\", \"page11\")\ntrg_map = {}\nfor row_idx, row in enumerate(trg_rows, 1):\n    if not row or len(row) < 8:\n        continue\n    patient_id = row[0]\n    trg_val = row[7].lower()\n    match = re.match(r\"Patient-(\\d+)\", patient_id)\n    if match:\n        pid = int(match.group(1))\n        if 81 <= pid <= 128:\n            # Map truth: 0,1,ccr -> 1 (good response), 2,3 -> 0 (poor response)\n            truth = 1 if trg_val in {\"0\", \"1\", \"ccr\"} else 0\n            trg_map[pid] = {\n                \"truth\": truth,\n                \"ref\": f\"supp.pdf/page11/R{row_idx}C8\"\n            }\n\n# Get organoid combined treatment ratio for P81-P128 from supp.pdf page13 (rows 41-44) and page14 (all rows)\nratio_rows_p13 = get_rows(\"supp.pdf\", \"page13\")\nratio_rows_p14 = get_rows(\"supp.pdf\", \"page14\")\nratio_rows = ratio_rows_p13 + ratio_rows_p14\nratio_map = {}\nfor row_idx, row in enumerate(ratio_rows, 1):\n    if not row or len(row) < 5:\n        continue\n    patient_id = row[0]\n    ratio_val = row[4]\n    match = re.match(r\"Patient(\\d+)\", patient_id)\n    if match:\n        pid = int(match.group(1))\n        if 81 <= pid <= 128:\n            try:\n                ratio = float(ratio_val)\n                # Score: <= 0.3487 -> 1 (sensitive), > -> 0 (resistant)\n                score = 1 if ratio <= 0.3487 else 0\n                sheet = \"page13\" if row_idx <= len(ratio_rows_p13) else \"page14\"\n                row_in_sheet = row_idx if sheet == \"page13\" else row_idx - len(ratio_rows_p13)\n                ratio_map[pid] = {\n                    \"score\": score,\n                    \"ref\": f\"supp.pdf/{sheet}/R{row_in_sheet}C5\",\n                    \"ratio\": ratio\n                }\n            except ValueError:\n                pass\n\n# Merge to create records, ensure 48 patients\nrecords = []\ncorrect = 0\nfor pid in range(81, 129):\n    if pid not in trg_map or pid not in ratio_map:\n        continue\n    records.append({\n        \"id\": f\"P{pid}\",\n        \"score\": {\n            \"ref\": ratio_map[pid][\"ref\"],\n            \"threshold\": 0.3487,\n            \"op\": \"<=\"\n        },\n        \"truth\": {\n            \"ref\": trg_map[pid][\"ref\"],\n            \"map\": {\"0\": 1, \"1\": 1, \"ccr\": 1, \"2\": 0, \"3\": 0}\n        }\n    })\n    if trg_map[pid][\"truth\"] == ratio_map[pid][\"score\"]:\n        correct += 1\n\naccuracy = correct / len(records) if records else 0.0\n\nCONTRACT = {\n    \"status\": \"computed\",\n    \"fields\": {\n        \"unit\": {\"value\": \"patient\", \"evidence\": [\"article:p16\"], \"explanation\": \"Each record is a unique LARC patient in the validation cohort (P81-P128)\"},\n        \"platform\": {\"value\": \"organoid\", \"evidence\": [\"article:p16\"], \"explanation\": \"Patient-derived rectal cancer organoids (RCOs) used for assay\"},\n        \"readout\": {\"value\": \"size_viability\", \"evidence\": [\"article:p16\"], \"explanation\": \"Assay readout is ratio of organoid size on day 24 post-combined chemoradiation to day 0\"},\n        \"direction\": {\"value\": \"lower_sensitive\", \"evidence\": [\"article:p16\"], \"explanation\": \"Lower size ratio indicates higher sensitivity to combined chemoradiation\"},\n        \"threshold_rule\": {\"value\": \"fixed_numeric\", \"evidence\": [\"article:p16\"], \"explanation\": \"Fixed cutoff of 0.3487 size change ratio, derived from discovery cohort\"},\n        \"threshold_timing\": {\"value\": \"independent_reference\", \"evidence\": [\"article:p16\"], \"explanation\": \"Threshold was pre-specified using the separate discovery cohort, not optimized on validation cohort\"},\n        \"patient_mapping\": {\"value\": \"individual_available\", \"evidence\": [\"article:p16\", \"article:p72\"], \"explanation\": \"One-to-one mapping between organoid lines and patients, clinical outcomes available for all 48 validation patients\"},\n        \"regimen_match\": {\"value\": \"matched\", \"evidence\": [\"article:p28\"], \"explanation\": \"Organoids were treated with the same combined chemoradiation regimen as patients\"},\n        \"n_units\": {\"value\": 48, \"evidence\": [\"article:p16\", \"article:p28\"], \"explanation\": \"Total 48 patients in the validation cohort\"},\n        \"split\": {\"value\": \"independent_test\", \"evidence\": [\"article:p16\"], \"explanation\": \"Validation cohort is separate from the discovery cohort used to set the threshold\"}\n    },\n    \"headline\": {\n        \"metric\": \"accuracy\",\n        \"reported\": 0.9375,\n        \"reported_evidence\": [\"article:p28\"],\n        \"threshold\": 0.3487,\n        \"op\": \"<=\",\n        \"score_direction\": \"higher\",\n        \"records\": records,\n        \"blocked_reason\": None\n    },\n    \"notes\": [f\"Computed accuracy: {accuracy:.4f}, correct classifications: {correct}, total records: {len(records)}\"]\n}\n\nprint(f\"Accuracy check: {accuracy} == 0.9375? {abs(accuracy - 0.9375) < 1e-6}\")\nprint(f\"Missing PIDs: {[pid for pid in range(81, 129) if pid not in trg_map or pid not in ratio_map]}\")\n"
    },
