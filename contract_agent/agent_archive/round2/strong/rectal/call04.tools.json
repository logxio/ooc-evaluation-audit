    "arguments": {
      "code": "truth_refs = {}\nfor i,pid in enumerate(range(81,87), start=39):\n    truth_refs[pid] = f'supp.pdf/page10/R{i}C8'\nfor i,pid in enumerate(range(87,129), start=1):\n    truth_refs[pid] = f'supp.pdf/page11/R{i}C8'\n\nscore_refs = {}\nfor i,pid in enumerate(range(81,85), start=41):\n    score_refs[pid] = f'supp.pdf/page13/R{i}C5'\nfor i,pid in enumerate(range(85,129), start=1):\n    score_refs[pid] = f'supp.pdf/page14/R{i}C5'\n\nrecords=[]\nfor pid in range(81,129):\n    records.append({\n        'id': f'P{pid}',\n        'score': {'ref': score_refs[pid], 'threshold': 0.3487, 'op': '<='},\n        'truth': {'ref': truth_refs[pid], 'map': {'ccr':1,'0':1,'1':1,'2':0,'3':0}}\n    })\n\n# independent audit using raw cells\ndef val_at(ref):\n    return cells[ref]\npred=[]; truth=[]\nfor pid in range(81,129):\n    s=float(val_at(score_refs[pid]))\n    traw=str(val_at(truth_refs[pid])).strip().lower()\n    t={'ccr':1,'0':1,'1':1,'2':0,'3':0}[traw]\n    pred.append(1 if s <= 0.3487 else 0)\n    truth.append(t)\nacc=sum(int(p==t) for p,t in zip(pred,truth))/48\nprint('n',len(records),'accuracy',acc,'mismatches',[81+i for i,(p,t) in enumerate(zip(pred,truth)) if p!=t])\n\nCONTRACT={\n 'status':'computed',\n 'fields':{\n  'unit':{'value':'patient','evidence':['article:p28'],'explanation':'The validation analysis contains 48 patients P81-P128, each represented by one corresponding organoid line.'},\n  'platform':{'value':'organoid','evidence':['article:p16'],'explanation':'Predictions come from patient-derived rectal cancer organoids.'},\n  'readout':{'value':'size_viability','evidence':['supp.pdf/page12/R1C10','supp.pdf/page12/R3C4'],'explanation':'The assay measure is the day-24 to day-0 organoid size-change ratio after combined chemoradiation.'},\n  'direction':{'value':'lower_sensitive','evidence':['article:p16'],'explanation':'A size recovery ratio at or below 0.3487 defines organoid sensitivity.'},\n  'threshold_rule':{'value':'roc_optimized','evidence':['article:p16','article:p29'],'explanation':'The 34.87% cutoff was selected using Youden index and bootstrap sampling in the discovery cohort.'},\n  'threshold_timing':{'value':'independent_reference','evidence':['article:p16','article:p28'],'explanation':'The cutoff was estimated in discovery patients P1-P80 and applied unchanged to validation patients P81-P128.'},\n  'patient_mapping':{'value':'individual_available','evidence':['article:p16'],'explanation':'Each patient number maps one-to-one to the matching organoid number.'},\n  'regimen_match':{'value':'matched','evidence':['article:p26','article:p28'],'explanation':'The combined chemoradiation organoid assay is compared directly with response to clinical neoadjuvant combined chemoradiation.'},\n  'n_units':{'value':48,'evidence':['article:p28'],'explanation':'Denominator for the independent validation cohort.'},\n  'split':{'value':'independent_test','evidence':['article:p16','article:p28'],'explanation':'P81-P128 are the held-out validation cohort after the P1-P80 discovery cohort.'}\n },\n 'headline':{\n  'metric':'accuracy',\n  'reported':0.9375,\n  'reported_evidence':['article:p28','article:p5'],\n  'threshold':0.3487,\n  'op':'<=',\n  'score_direction':'lower',\n  'records':records,\n  'blocked_reason':''\n },\n 'notes':['Clinical truth is good response for cCR, pTRG 0, or pTRG 1; poor response is pTRG 2 or pTRG.','The three discordant validation cases are P104 (assay sensitive but clinical poor), P105 and P124 (assay resistant but clinical good), giving 45/48 = 0.9375.']\n}"
