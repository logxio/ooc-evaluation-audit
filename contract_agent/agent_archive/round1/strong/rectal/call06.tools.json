    "arguments": {
      "code": "\nimport re\n\nCUT = 0.3487\ntrg_refs = {}\nfor pg in ['page9','page10','page11','page12']:\n    rows = tables['supp.pdf'][pg]['rows']\n    for i, r in enumerate(rows, start=1):\n        name = str(r[0]).strip() if r[0] else ''\n        m = re.match(r'Patient[- ]?(\\d+)$', name)\n        if m and len(r) > 7 and r[7] is not None:\n            trg_refs[int(m.group(1))] = (f'supp.pdf/{pg}/R{i}C8', str(r[7]).strip())\n\nratio_refs = {}\nfor pg in ['page12','page13','page14']:\n    rows = tables['supp.pdf'][pg]['rows']\n    for i, r in enumerate(rows, start=1):\n        name = str(r[0]).strip() if r[0] else ''\n        m = re.match(r'Patient[- ]?(\\d+)$', name)\n        if m and len(r) > 4 and r[4] is not None:\n            try:\n                v = float(r[4])\n            except Exception:\n                continue\n            ratio_refs[int(m.group(1))] = (f'supp.pdf/{pg}/R{i}C5', v)\n\ntmap = {\"0\":1, \"1\":1, \"ccr\":1, \"2\":0, \"3\":0}\nrecords = []\nagree = 0\nfor pid in range(81, 129):\n    rref, ratio = ratio_refs[pid]\n    tref, trg = trg_refs[pid]\n    pred = 1 if ratio <= CUT else 0\n    truth = tmap[trg.lower()]\n    agree += int(pred == truth)\n    records.append({\n        \"id\": f\"P{pid}\",\n        \"score\": {\"ref\": rref, \"threshold\": CUT, \"op\": \"<=\"},\n        \"truth\": {\"ref\": tref, \"map\": tmap},\n    })\n\nacc = agree / len(records)\nprint(len(records), agree, acc)\n\nCONTRACT = {\n    \"status\": \"computed\",\n    \"fields\": {\n        \"unit\": {\"value\": \"patient\", \"evidence\": [\"article:p28\", \"supp.pdf/page15/R30C4\"],\n                 \"explanation\": \"One patient-derived rectal cancer organoid line per LARC patient (P81-P128, O81-O128); validation cohort denominator is 48 patients.\"},\n        \"platform\": {\"value\": \"organoid\", \"evidence\": [\"article:p16\", \"gr2.jpg\"],\n                     \"explanation\": \"Patient-derived rectal cancer organoid (RCO) lines treated ex vivo with irradiation, 5-Fu and CPT-11.\"},\n        \"readout\": {\"value\": \"size_viability\", \"evidence\": [\"supp.pdf/page12/R1C1\", \"supp.pdf/page12/R1C4\"],\n                    \"explanation\": \"Table S2 reports ratios of RCO size change on day 24 to day 0 after single and combined chemoradiation (survival/size readout).\"},\n        \"direction\": {\"value\": \"lower_sensitive\", \"evidence\": [\"article:p16\"],\n                      \"explanation\": \"Size recovery ratio <= 34.87% defines a sensitive organoid line; > 34.87% defines resistance.\"},\n        \"threshold_rule\": {\"value\": \"roc_optimized\", \"evidence\": [\"article:p16\", \"article:p29\"],\n                           \"explanation\": \"Cutoff 34.87% (95% CI 34.30-40.14) is the mean optimal cutoff from Youden's index with bootstrap sampling.\"},\n        \"threshold_timing\": {\"value\": \"independent_reference\", \"evidence\": [\"article:p16\"],\n                             \"explanation\": \"The 34.87% cutoff was optimized on the discovery cohort organoids O1-O80 and then applied unchanged to the held-out validation cohort O81-O128.\"},\n        \"patient_mapping\": {\"value\": \"individual_available\", \"evidence\": [\"supp.pdf/page9/R3C1\", \"supp.pdf/page12/R6C1\", \"article:p19\"],\n                            \"explanation\": \"Table S1 gives per-patient TRG/cCR and Table S2 gives per-patient organoid size ratios; P and O numbers correspond one-to-one.\"},\n        \"regimen_match\": {\"value\": \"partial\", \"evidence\": [\"supp.pdf/page10/R39C7\", \"supp.pdf/page10/R41C7\", \"article:p16\"],\n                          \"explanation\": \"Organoid combined chemoradiation (8 Gy + 5-Fu 10 uM + CPT-11 10 uM) matches the 39 validation patients on radiation/irinotecan/capecitabine, but 8 received radiation/capecitabine only and 1 irinotecan/capecitabine without radiation.\"},\n        \"n_units\": {\"value\": 48, \"evidence\": [\"supp.pdf/page15/R30C4\", \"article:p28\"],\n                    \"explanation\": \"Table S5 total for the validation cohort diagnostic test is 48 patients (20 organoid-sensitive + 28 organoid-resistant).\"},\n        \"split\": {\"value\": \"independent_test\", \"evidence\": [\"article:p16\", \"article:p28\"],\n                  \"explanation\": \"P81-P128 are a prospectively held-out validation cohort distinct from the P1-P80 discovery cohort used to fit the cutoff.\"},\n    },\n    \"headline\": {\n        \"metric\": \"accuracy\",\n        \"reported\": 0.9375,\n        \"reported_evidence\": [\"supp.pdf/page15/R31C1\", \"article:p28\", \"mmc2.pdf/page6/R8C4\"],\n        \"threshold\": CUT,\n        \"op\": \"==\",\n        \"score_direction\": \"lower\",\n        \"records\": records,\n        \"blocked_reason\": None,\n    },\n    \"notes\": [\n        \"Reconstruction: for each of the 48 validation patients, the Table S2 combined-chemoradiation day24/day0 size ratio is binarized at the discovery-derived cutoff 0.3487 (<= cutoff = organoid sensitive = predicted good responder), and compared with the Table S1 clinical outcome (TRG 0/1 or cCR = good = 1; TRG 2/3 = poor = 0).\",\n        \"Agreement is 45/48 = 0.9375, matching Table S5 'Accuracy(%)=(19+26)/(20+28)=93.75%' and the text (93.75% accuracy, 96.30% sensitivity, 90.48% specificity).\",\n        \"The three discordant cases are exactly those named in the text: P104 (ratio 0.3454, sensitive organoid but pTRG 2), P105 (ratio 0.6035, resistant organoid but cCR) and P124 (ratio 0.4641, resistant organoid but pTRG 0).\",\n        \"Organoid assay labels (sensitive/resistant) are kept distinct from patient clinical outcomes (TRG/cCR); accuracy is the concordance between the two, not an assay replicate statistic.\",\n    ],\n}\nprint('records', len(CONTRACT['headline']['records']), 'acc', acc)\n"
    },
